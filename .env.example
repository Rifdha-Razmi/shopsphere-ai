# ShopSphere AI — environment variables (copy to .env.local)
# No secrets or API keys are needed for this project (PRD §2 Zero-Cost Guarantee).

# Base URL of the product API. Defaults to the public DummyJSON API.
# Set to "/api/mock" to run fully offline against the bundled DummyJSON snapshot.
NEXT_PUBLIC_PRODUCT_API_URL=https://dummyjson.com

# Mock session lifetime (minutes of inactivity before the session expires).
NEXT_PUBLIC_SESSION_TTL_MINUTES=30

# USD -> INR display conversion rate applied to DummyJSON prices.
NEXT_PUBLIC_USD_TO_INR=83
